# Copy to .env in this same folder and fill in your values.
ALEX_HOST=raspberrypi.local
ALEX_PORT=8787
ALEX_TOKEN=paste-the-ALEX_API_TOKEN-from-the-Pi-here
# Minimum notification priority (0-3) that triggers a popup. Lower priority
# notifications are still received but only logged to the console.
ALEX_CLIENT_MIN_PRIORITY=1
