<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/cyan"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginBottom="20dp" />

        <TextView style="@style/Label" android:text="@string/label_host" />
        <EditText
            android:id="@+id/input_host"
            style="@style/Field"
            android:hint="raspberrypi.local"
            android:inputType="textUri" />

        <TextView style="@style/Label" android:text="@string/label_port" />
        <EditText
            android:id="@+id/input_port"
            style="@style/Field"
            android:hint="8787"
            android:inputType="number" />

        <TextView style="@style/Label" android:text="@string/label_token" />
        <EditText
            android:id="@+id/input_token"
            style="@style/Field"
            android:hint="ALEX_API_TOKEN"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_save" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp"
            android:background="@color/line"
            android:alpha="0.25" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_autostart"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/switch_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_overlay_permission"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_stop" />

        <Button
            android:id="@+id/btn_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/btn_chat" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
