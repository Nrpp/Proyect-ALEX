# Copy this file to .env and fill in the values. Never commit the real .env.
#
#   cp .env.example .env

# --- Identity ---------------------------------------------------------------
ALEX_ASSISTANT_NAME=Alex
ALEX_OWNER_NAME=Nicolas
ALEX_TIMEZONE=Europe/Madrid

# --- Server / API ------------------------------------------------------------
ALEX_HOST=0.0.0.0
ALEX_PORT=8787
# REQUIRED before exposing ALEX beyond localhost. Generate with:
#   openssl rand -hex 32
ALEX_API_TOKEN=
# Comma-separated origins if you later add a browser-based client; "*" is fine on a trusted LAN.
ALEX_CORS_ORIGINS=["*"]

# --- Storage / logging --------------------------------------------------------
ALEX_LOG_LEVEL=INFO

# --- AI provider ---------------------------------------------------------------
# "nvidia" (NVIDIA NIM, free tier, https://build.nvidia.com), "anthropic" (Claude),
# "openrouter" (https://openrouter.ai, many vendors/models behind one key, including
# several free-tier ones), or "anyapi" (https://anyapi.ai, same idea, 400+ models).
ALEX_AI_PROVIDER=nvidia

ALEX_NVIDIA_API_KEY=
ALEX_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ALEX_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

ALEX_ANTHROPIC_API_KEY=
ALEX_ANTHROPIC_MODEL=claude-sonnet-4-5

ALEX_OPENROUTER_API_KEY=
ALEX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier default - browse paid/free options at https://openrouter.ai/models
ALEX_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

ALEX_ANYAPI_API_KEY=
ALEX_ANYAPI_BASE_URL=https://api.anyapi.ai/v1
# Model ids are "provider/model-name". This default was verified working end-to-end
# (chat + tool-calling) on a real free account. Paid models (e.g. "openai/gpt-4o-mini")
# need account credits (403 key_model_access_denied without them), and some free-tier
# models 404 despite being listed (delisted/unavailable upstream). If you switch,
# confirm the new one actually responds first:
#   curl https://api.anyapi.ai/v1/models -H "Authorization: Bearer $ALEX_ANYAPI_API_KEY"
#   curl https://api.anyapi.ai/v1/chat/completions -H "Authorization: Bearer $ALEX_ANYAPI_API_KEY" \
#     -H "Content-Type: application/json" -d '{"model": "<candidate>", "messages": [{"role":"user","content":"hola"}]}'
ALEX_ANYAPI_MODEL=nvidia/nemotron-nano-9b-v2:free

ALEX_AI_MAX_TOKENS=1024
ALEX_AI_TEMPERATURE=0.4
# Per-request timeout (seconds) for a single call to the AI provider. Prevents a
# slow/unresponsive provider from hanging a whole conversational turn indefinitely.
ALEX_AI_REQUEST_TIMEOUT_SECONDS=45
# Timeout (seconds) for an ENTIRE turn (all AI<->tool hops combined). Bounds total
# latency even if the model takes several hops, each under the request timeout above.
ALEX_AI_TURN_TIMEOUT_SECONDS=90

# --- Plugins ---------------------------------------------------------------------
# "web" (read web pages) and "daily_briefing" (morning news/agenda/tasks) need no
# credentials, so they're on by default. Add "home_assistant", "email",
# "google_calendar", "google_tasks", "ms_todo" once configured below. Add
# "system_exec" ONLY if you want ALEX to be able to run shell commands on this
# machine (CONFIRM-gated, but full access when approved) - see
# docs/INSTALL_RASPBERRY_PI.md section 11 before enabling it. Add "alexos" if you
# run AlexOS (see ALEX_ALEXOS_BASE_URL below) and want ALEX to read/act on it.
ALEX_ENABLED_PLUGINS=["system","reminders","web","daily_briefing"]
ALEX_BLOCKED_TOOLS=[]

# --- Integration: Home Assistant (optional, see docs/INSTALL_RASPBERRY_PI.md) ------
ALEX_HOME_ASSISTANT_URL=
ALEX_HOME_ASSISTANT_TOKEN=

# --- Integration: AlexOS (optional) -------------------------------------------------
# The personal-OS dashboard - a separate project, usually running on this same Pi.
# No token needed, its REST API has no auth of its own (LAN-only by design). Default
# assumes AlexOS's production docker-compose (network_mode: host, api on port 8000).
ALEX_ALEXOS_BASE_URL=http://127.0.0.1:8000

# --- Integration: Gmail (optional, run scripts/google_oauth_auth.py --scopes gmail) --
# Same Client ID/Secret as Calendar/Tasks works fine - just enable the Gmail API too
# on that Cloud project.
ALEX_GMAIL_ADDRESS=
ALEX_GOOGLE_GMAIL_CLIENT_ID=
ALEX_GOOGLE_GMAIL_CLIENT_SECRET=
ALEX_GOOGLE_GMAIL_REFRESH_TOKEN=
ALEX_GMAIL_CHECK_INTERVAL_SECONDS=300

# --- Integration: Google Calendar (optional, run scripts/google_oauth_auth.py) -----
ALEX_GOOGLE_CALENDAR_CLIENT_ID=
ALEX_GOOGLE_CALENDAR_CLIENT_SECRET=
ALEX_GOOGLE_CALENDAR_REFRESH_TOKEN=
ALEX_GOOGLE_CALENDAR_ID=primary
ALEX_GOOGLE_CALENDAR_CHECK_INTERVAL_SECONDS=1800

# --- Integration: Google Tasks (optional, run scripts/google_oauth_auth.py) --------
ALEX_GOOGLE_TASKS_CLIENT_ID=
ALEX_GOOGLE_TASKS_CLIENT_SECRET=
ALEX_GOOGLE_TASKS_REFRESH_TOKEN=
ALEX_GOOGLE_TASKS_LIST_ID=@default
ALEX_GOOGLE_TASKS_CHECK_INTERVAL_SECONDS=1800

# --- Integration: Microsoft To Do (optional, device-code auth on first run) --------
ALEX_MS_CLIENT_ID=
ALEX_MS_TENANT=consumers
ALEX_MS_TODO_CHECK_INTERVAL_SECONDS=900

# --- Voice (leave disabled until mic/model setup is done - see docs/INSTALL_RASPBERRY_PI.md) ---
ALEX_VOICE_ENABLED=false
ALEX_WAKEWORD_MODEL_PATH=
ALEX_WAKEWORD_NAME=hey_jarvis
ALEX_WAKEWORD_THRESHOLD=0.5
ALEX_MIC_DEVICE=
ALEX_STT_MODEL_SIZE=small
ALEX_STT_LANGUAGE=es
ALEX_TTS_VOICE=es_ES-davefx-medium
ALEX_CONVERSATION_FOLLOW_UP_SECONDS=8.0

# --- Notifications ------------------------------------------------------------------
ALEX_NOTIFICATION_MIN_PRIORITY_PUSH=2

# --- Web browsing (optional, no credentials needed) ---------------------------------
ALEX_WEB_FETCH_TIMEOUT_SECONDS=10

# --- Daily briefing (optional - news works with no other config; today's calendar
# events / pending tasks are added automatically once Google Calendar/Tasks above
# are configured, skipped otherwise) --------------------------------------------------
# Local time (HH:MM, in ALEX_TIMEZONE) the briefing fires once a day. Ask for it any
# time via chat/voice too ("dime las noticias de hoy") - doesn't need to wait for this.
ALEX_BRIEFING_TIME=07:30
ALEX_BRIEFING_NEWS_RSS_URL=https://feeds.bbci.co.uk/mundo/rss.xml
ALEX_BRIEFING_NEWS_MAX_ITEMS=5

# --- Web Push (optional - reach a phone, including an iPhone, even while the web
# console isn't open; see clients/web_console's README/docs for the full setup,
# which for iOS also needs HTTPS - e.g. via `tailscale serve`). Generate with:
#   python3 scripts/gen_vapid_keys.py
ALEX_VAPID_PUBLIC_KEY=
ALEX_VAPID_PRIVATE_KEY=
ALEX_VAPID_CONTACT_EMAIL=
